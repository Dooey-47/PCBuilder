DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pcstore?schema=public"
PORT=3000
SESSION_SECRET="replace-with-a-generated-secret-of-at-least-32-characters"

# Optional: set BOTH values before seeding to create a local demo administrator.
# Existing accounts and passwords are never overwritten.
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""

# Optional: enables integration tests. Tests use their own temporary schema.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pcstore?schema=public"
